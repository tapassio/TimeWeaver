# Application Settings
APP_TITLE=TimeWeaver

# PostgreSQL Database & API Settings
# Defaults for local development (can be configured in Settings UI and persisted in localStorage)
DATABASE_URL=http://localhost:3000/api
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=timeweaver
POSTGRES_USER=timeweaver
POSTGRES_PASSWORD=timeweaver

# OIDC Authentication Settings
# Configure your OIDC Identity Provider (e.g. EduID, docPouch, Keycloak, etc.)
OIDC_ISSUER=http://localhost:3030/oidc
OIDC_CLIENT_ID=timeWeaver.local
OIDC_PROVIDER_NAME=docPouch
OIDC_REGISTRATION_TOKEN=TestToken # Only needed if using docPouch for user auth

# Timefold Solver Service (Java, https://github.com/TimefoldAI/timefold-solver)
# Leerer Wert → Fallback auf die lokale Hybrid-Engine (cp-sat-ts → or-tools-wasm)
TIMEFOLD_URL=
# SOLVER_ENGINE: timefold (Default) | timefold-only | cp-sat-ts | or-tools-wasm
SOLVER_ENGINE=timefold
